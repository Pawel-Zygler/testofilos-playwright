{
  "name": "testofilos-playwright",
  "version": "1.0.0",
  "description": "Playwright test suite for https://pawel-zygler.github.io/testofilos/",
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" playwright test",
    "test:headed": "NODE_OPTIONS=\"--import tsx\" playwright test --headed",
    "test:ui": "NODE_OPTIONS=\"--import tsx\" playwright test --ui",
    "test:debug": "NODE_OPTIONS=\"--import tsx\" playwright test --debug",
    "test:smoke": "NODE_OPTIONS=\"--import tsx\" playwright test --grep @smoke",
    "test:a11y": "NODE_OPTIONS=\"--import tsx\" playwright test --grep @a11y",
    "test:regression": "NODE_OPTIONS=\"--import tsx\" playwright test --grep @regression",
    "test:links": "NODE_OPTIONS=\"--import tsx\" playwright test --grep @links",
    "test:visual": "NODE_OPTIONS=\"--import tsx\" playwright test --grep @visual",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "tsc --noEmit"
    ]
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "e2e",
    "filozofia-testowania"
  ],
  "author": "Paweł Zygler",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
